{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for every md-light editor window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "dialog:default",
    "opener:default"
  ]
}
